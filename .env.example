# Public URL used in generated short links.
PUBLIC_ORIGIN=https://s.example.com

# Admin token for /admin (at least 16 characters). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional JSON array or comma-separated list. Defaults to approved_domains.json.
# Domains saved in the admin area take precedence.
APPROVED_DOMAINS=example.com,example.org

# Optional Cloudflare Access sign-in (all three are required to enable it).
ACCESS_ISSUER=
ACCESS_AUD=
ADMIN_EMAILS=

# --- Abuse protection (all optional; see the README) ---
# Abuse contact shown on the site and the warning page.
ABUSE_EMAIL=
# Cloudflare Turnstile for links outside the approved domains.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Destination checks. Safe Browsing also re-checks links every 3 hours.
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
# Visitor sign-in (needed for the "signed_in" destination policy). SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alerts: a Slack/Discord-compatible webhook and/or Telegram.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Header set by your reverse proxy with the visitor address, e.g. x-forwarded-for or cf-connecting-ip.
# Leave empty when the container is reached directly.
CLIENT_IP_HEADER=
